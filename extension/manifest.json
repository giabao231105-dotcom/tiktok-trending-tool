{
  "manifest_version": 3,
  "name": "ZVibe TikTok Trending Helper",
  "version": "1.0.0",
  "description": "Tiện ích kết nối ZVibe Web Tool và TikTok giúp tự động quét toàn bộ video kênh qua trình duyệt",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://tiktok-trending-tool.onrender.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tiktok-trending-tool.onrender.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["bridge-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": ["tiktok-scraper.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZVibe TikTok Helper"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
